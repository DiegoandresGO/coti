# Copia este archivo como .env y cambia los valores
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_clave
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_secreta_larga
# Minutos sin actividad antes de cerrar la sesión del panel (por defecto 30)
SESSION_TIMEOUT_MINUTES=30
# WhatsApp comercial por defecto (si la cotización no define uno propio)
WHATSAPP_NUMBER=+57 300 123 4567
# Indicativo que se agrega a números de 10 dígitos (Colombia = 57)
WHATSAPP_COUNTRY_CODE=57
